// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id           Int            @id @default(autoincrement())
  name         String         @unique
  logo         String?
  jobs         Jobs[]
  URL          String
  instructions Instructions[]

  @@map("company")
}

model Jobs {
  id             String   @id @default(uuid())
  hybridOrRemote String
  fullTimeOrNot  String
  location       String
  datePosted     DateTime @updatedAt
  jobTitle       String
  jobDescription String
  company        Company  @relation(fields: [companyID], references: [id], onDelete: Cascade)
  companyID      Int

  @@map("jobs")
}

model Instructions {
  id                Int     @id @default(autoincrement())
  careersButton     String?
  joinUsButton      String?
  loadMoreButton    String?
  locationSelect    String?
  jobCategorySelect String?
  jobTypingInput    String?
  submitFormButton  String?
  scrollToContainer String?
  nextPageButton    String?
  jobsContainer     String?
  company           Company @relation(fields: [companyID], references: [id], onDelete: Cascade)
  companyID         Int

  @@map("instructions")
}
