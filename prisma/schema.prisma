// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id              Int     @id @default(autoincrement())
  firstName       String?
  lastName        String?
  password        String
  confirmPassword String
  location        String?
  email           String
  phoneNumber     Int?
  linkedInURL     String?
  githubURL       String?
  portfolioURL    String?
  profilePicture  String?
  role            Role    @default(USER)

  @@map("user")
}

model Company {
  id                Int            @id @default(autoincrement())
  name              String         @unique
  logo              String?
  jobs              Jobs[]
  URL               String
  browserNavigation String?
  instructions      Instructions[]

  @@map("company")
}

model Jobs {
  id             Int      @id @default(autoincrement())
  title          String
  location       String
  remoteOrHybrid String
  datePosted     DateTime @updatedAt
  description    String
  anchorHref     String?
  company        Company  @relation(fields: [companyID], references: [id], onDelete: Cascade)
  companyID      Int

  @@map("jobs")
}

model Instructions {
  id             Int     @id @default(autoincrement())
  container      Json?
  title          Json?
  location       Json?
  remoteOrHybrid Json?
  datePosted     Json?
  anchorHref     Json?
  company        Company @relation(fields: [companyID], references: [id], onDelete: Cascade)
  companyID      Int
  steps          Steps[]

  @@map("instructions")
}

model Steps {
  id             Int          @id @default(autoincrement())
  action         String
  selector       String
  instructions   Instructions @relation(fields: [instructionsID], references: [id], onDelete: Cascade)
  instructionsID Int

  @@map("steps")
}

model Session {
  id        String   @id
  sid       String   @unique
  data      String
  expiresAt DateTime
}
